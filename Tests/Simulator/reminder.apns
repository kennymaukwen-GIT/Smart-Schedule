{
  "Simulator Target Bundle": "com.smartschedules.app",
  "aps": {
    "alert": {
      "title": "Online meeting with Joe",
      "subtitle": "In 30 min",
      "body": "15:30 · Google Meet\nHold to edit or snooze"
    },
    "category": "SS_EVENT_REMINDER",
    "interruption-level": "time-sensitive",
    "sound": "default"
  },
  "ssEventId": "demo-meeting-joe",
  "ssKind": "event",
  "ssOffset": 30,
  "ssAllDay": false,
  "ssFromDefaults": true
}
