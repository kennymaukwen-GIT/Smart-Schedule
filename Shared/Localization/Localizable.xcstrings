          }
        }
      }
    },
    "You may get two alerts for the same event, one from Google and one from Smart Schedules. Turning off notifications for the Google Calendar app on this iPhone avoids that." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一個行程可能會收到兩則提醒，一則來自 Google，一則來自 Smart Schedules。關閉這支 iPhone 上 Google 日曆 App 的通知就能避免。"
          }
        }
      }
    },
    "You said: “%@”" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你說：「%@」"
          }
        }
      }
    },
    "You sign in on Google's own page. Smart Schedules never sees your password and only gets access to your calendars." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入在 Google 的官方頁面完成，Smart Schedules 看不到你的密碼，只會取得你的日曆存取權。"
          }
        }
      }
    },
