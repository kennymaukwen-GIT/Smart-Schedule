<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- What the user types or says (as text), and the titles, times, notes and Google event IDs of up to 40 events in
		     the 14 days from today (a location only for AI suggestions on one event), sent through Smart Schedule's server to
		     Google's Gemini API; no Google account email. The server keeps none of it, and version 1.0 keeps nothing about
		     events on the server (no Live Activity push-to-start: AppConstants.pushToStartEnabled is false). Declared as
		     linked: each request carries this install's App Attest key ID (Device ID below). Never used for tracking. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Still collected in version 1.0: the App Attest key ID, made for this install and sent with every request to
		     Smart Schedule's server, which keeps it with its public key (no expiry) to check each request and limit
		     requests per install; the notification extension's session token is issued for it. Not a push-to-start
		     install ID or push token: version 1.0 has none (AppConstants.pushToStartEnabled is false). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults: CA92.1 = this bundle's own defaults (UserDefaults.standard: demo-mode switch, Quick Capture
		     view mode); 1C8F.1 = the App Group suite group.com.smartschedule.shared shared by the app and its two
		     extensions (consent, preferences flags, sync state). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
