// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
DEVELOPMENT_TEAM =

// Google Cloud Console → APIs & Services → Credentials → OAuth client ID → iOS
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =

// Smart Schedule's server (server/worker, see its README). The Gemini key lives there as a Worker secret, never in
// the app. The production Worker for every build, except the simulator (no App Attest), which uses the development
// Worker (`npm run deploy:dev`) with the dev token below:
// GEMINI_BASE_URL = https:/$()/smart-schedule-worker.<account subdomain>.workers.dev/v1beta
// GEMINI_BASE_URL[sdk=iphonesimulator*] = https:/$()/smart-schedule-worker-dev.<account subdomain>.workers.dev/v1beta
GEMINI_BASE_URL =

// Debug builds on the simulator: the development Worker's SS_DEV_TOKEN secret (only a Worker with
// ALLOW_DEV_TOKEN = "true" accepts it). Release builds always send nothing here.
// SS_DEV_TOKEN[sdk=iphonesimulator*] = <the development Worker's SS_DEV_TOKEN>
SS_DEV_TOKEN =
