// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
DEVELOPMENT_TEAM =

// Google Cloud Console → APIs & Services → Credentials → OAuth client ID → iOS
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =

// Smart Schedule's server (server/worker, see its README). The Gemini key lives there as a Worker secret, never in
// the app. Local: the URL `wrangler dev` prints; release builds: the deployed Worker.
// GEMINI_BASE_URL = https:/$()/<your worker host>/v1beta
GEMINI_BASE_URL =

// Debug builds on the simulator (no App Attest): the same value as the Worker's SS_DEV_TOKEN secret, with
// ALLOW_DEV_TOKEN = "true" on a development Worker only. Release builds always send nothing here.
SS_DEV_TOKEN =
