// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
DEVELOPMENT_TEAM =

// Google Cloud Console → APIs & Services → Credentials → OAuth client ID → iOS
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =

// Smart Schedule's server (server/worker, see its README). The Gemini key lives there as a Worker secret, never in
// the app. Release builds (TestFlight, App Store) use the production Worker. Every build attests in App Attest's
// production environment (project.yml), so a Debug build on an iPhone works with either Worker; without a development
// Worker, comment out the Debug line and Debug builds use the production one too. The simulator has no App Attest: it
// sends the dev token, which only the development Worker (`npm run deploy:dev`) accepts.
// The unconditional line must come first: in an xcconfig the last matching assignment wins.
GEMINI_BASE_URL = https:/$()/smart-schedule-worker.<account subdomain>.workers.dev/v1beta
GEMINI_BASE_URL[config=Debug] = https:/$()/smart-schedule-worker-dev.<account subdomain>.workers.dev/v1beta

// Debug builds on the simulator: the development Worker's SS_DEV_TOKEN secret (only a Worker with
// ALLOW_DEV_TOKEN = "true" accepts it). Release builds always send nothing here (project.yml).
SS_DEV_TOKEN[config=Debug][sdk=iphonesimulator*] = <the development Worker's SS_DEV_TOKEN>

// Optional, the simulator against a Worker on this Mac (`npm run dev` in server/worker, its .dev.vars holding the same
// SS_DEV_TOKEN). Plain http is accepted only for localhost. Keep it last so it wins over the Debug line above.
// GEMINI_BASE_URL[config=Debug][sdk=iphonesimulator*] = http:/$()/localhost:8787/v1beta
