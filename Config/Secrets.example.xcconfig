// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
DEVELOPMENT_TEAM = ABCDE12345

// Google Cloud Console → APIs & Services → Credentials → OAuth client ID → iOS
GOOGLE_IOS_CLIENT_ID = 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefg

// DEV ONLY. In production point GEMINI_BASE_URL at your proxy (Cloud Run / Firebase AI Logic + App Check)
// and leave GEMINI_API_KEY empty — a key shipped in an IPA is extractable in minutes.
GEMINI_API_KEY = your-dev-key
// GEMINI_BASE_URL = https:/$()/your-proxy.example.com/v1beta
